{
  "manifest_version": 3,
  "name": "Better Esimson",
  "version": "1.4.0",
  "description": "심슨어학원 사이트를 더 빠르고 현대적인 화면으로 바꿉니다.",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "Better Esimson",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icon.png", "logo/*.png", "image/*.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "https://esimson.com/*",
    "https://www.esimson.com/*",
    "http://esimson.com/*",
    "http://www.esimson.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://esimson.com/*",
        "https://www.esimson.com/*",
        "http://esimson.com/*",
        "http://www.esimson.com/*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://esimson.com/*", "https://www.esimson.com/*",
        "http://esimson.com/*", "http://www.esimson.com/*"
      ],
      "js": ["page-bridge.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
